  "stable_inventory_rule": "enabled stable files only; manifest/report/READY excluded",
  "control_files": {
    "manifest/manifest.json": {
      "hashes": "stable files only"
    },
    "manifest/validation_report.json": {
      "binds": [
        "manifest_sha256"
      ],
      "scope": [
        "synthetic",
        "real-file"
      ],
      "overall": [
        "pass",
        "fail",
        "blocked"
      ]
    },
    "manifest/HANDOFF_READY.json": {
      "binds": [
        "manifest_sha256",
        "report_sha256"
      ],
      "on_success_only": true
    }
  },
  "field_dictionary": "field_dictionary.csv",
  "float_wire": "round-trip decimal representation for IEEE754 float64; finite only; independent formula comparison absolute tolerance1e-12",
  "CSV_reader": "dtype=str keep_default_na=False na_values=[configured sentinel]; explicit column conversion; JSON files decode as JSON, not CSV",
  "disabled_defaults": [
    "handoff/raw_provenance.csv",
    "handoff/sensitivity_snapshot.csv",
    "data/processed/CURRENT_HANDOFF.json"
  ],
  "main_record_domain": "steam.csv records only; auxiliary identities diagnosed separately",
  "formal_production_status": "NOT_STARTED"
}
